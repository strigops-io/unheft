<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>unheft</ToolCommandName>
    <PackageId>unheft</PackageId>
    <Version>1.0.0</Version>
    <Authors>strigops.io</Authors>
    <Description>Strigops Unheft — EF Core Migration Designer File Consolidation Tool</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/strigops-io/unheft</PackageProjectUrl>
    <RepositoryUrl>https://github.com/strigops-io/unheft</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>efcore;migrations;dotnet-tool</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Unheft.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.0.0-beta5.25306.1" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.13.0" />
  </ItemGroup>

</Project>
